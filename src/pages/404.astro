---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import BackgroundBeams from "../components/BackgroundBeams.astro";
import ui from "../i18n/es/ui.json";

const t = ui.notFound;
const nav = ui.nav;
---

<Layout title="404" lang="es">
  <Navbar t={nav} lang="es" />

  <main class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <BackgroundBeams />

    <div class="relative z-10 flex flex-col items-center text-center px-6 animate-fade-up">
      <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted mb-6">{t.label}</div>

      <h1 class="text-[clamp(44px,6.4vw,88px)] leading-[.98] tracking-[-0.035em] font-semibold text-ink mb-6 text-balance">
        {t.heading} <span class="font-serif italic text-accent">{t.headingItalic}</span>.
      </h1>

      <p class="text-[18px] text-muted mb-10 max-w-[36ch] leading-[1.6]">
        {t.sub}
      </p>

      <a
        href="/"
        class="group inline-flex items-center gap-[10px] px-[22px] py-[14px] rounded-full text-[14.5px] font-medium tracking-[-0.005em] bg-ink text-bg [transition:translate_200ms_ease,background_200ms_ease] hover:bg-[#e0e0e0] hover:-translate-y-px"
      >
        {t.cta}
      </a>
    </div>
  </main>
</Layout>
