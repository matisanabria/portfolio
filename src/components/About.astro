---
interface StackItem { area: string; name: string; sub: string; detail: string; tags: string[] }

interface Props {
  t: {
    sectionLabel: string;
    heading: string;
    headingItalic: string;
    bio: string[];
    stackLabel: string;
    stack: StackItem[];
  };
}

const { t } = Astro.props;
const stack = t.stack;
---

<section id="about" class="relative py-[80px]">
  <div class="w-full max-w-[1240px] mx-auto px-8 max-[720px]:px-5">

    <div class="grid grid-cols-[1.1fr_.9fr] gap-[60px] max-[960px]:grid-cols-1 max-[960px]:gap-12">

      <!-- Bio -->
      <div>
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted">{t.sectionLabel}</div>
        <h2 class="text-[clamp(40px,5.5vw,72px)] font-semibold tracking-[-0.03em] text-ink leading-none mt-2 mb-10">
          {t.heading} <span class="font-serif italic text-accent">{t.headingItalic}</span>.
        </h2>
        {t.bio.map((paragraph, i) => (
          <p
            class:list={["text-[18px] leading-[1.55] text-ink max-w-[50ch] [&_strong]:font-semibold [&_em]:font-serif [&_em]:italic [&_em]:text-[1.05em]", i > 0 && "mt-[18px]"]}
            set:html={paragraph}
          />
        ))}
      </div>

      <!-- Stack timeline -->
      <div>
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted mb-[18px]">{t.stackLabel}</div>
        <div class="border-t border-[var(--line)]">
          {stack.map((s) => (
            <div class="grid grid-cols-[80px_1fr_auto] gap-6 py-5 border-b border-[var(--line)] items-start max-[640px]:grid-cols-1 max-[640px]:gap-2">
              <div class="font-mono text-[11px] text-muted pt-[3px] tracking-[0.04em]">{s.area}</div>
              <div>
                <h4 class="m-0 mb-1 text-[16px] font-semibold tracking-[-0.01em] text-ink">{s.name}</h4>
                <div class="flex flex-col gap-px">
                  <span class="text-[12.5px] text-accent font-medium">{s.sub}</span>
                  <span class="text-[12.5px] text-muted">{s.detail}</span>
                </div>
              </div>
              <div class="flex flex-wrap gap-1 justify-end max-[640px]:justify-start">
                {s.tags.map((t) => (
                  <span class="font-mono text-[10px] px-2 py-[3px] rounded-full border border-[var(--line)] text-muted">{t}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
