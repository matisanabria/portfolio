---
interface ExpEntry {
  period: string;
  mode: string;
  role: string;
  company: string;
  location: string;
  desc: string;
  tags: string[];
  active?: boolean;
}

const experience: ExpEntry[] = [
  {
    period: "2024 — presente",
    mode: "Tiempo completo",
    role: "Desarrollador Freelance",
    company: "Independiente",
    location: "Encarnación, PY · Remoto",
    desc: "Construyo sistemas a medida y sitios web para clientes en Paraguay y la región. Desde el diseño hasta el deploy: backend en Laravel, frontend con Astro y React, infraestructura en Cloudflare.",
    tags: ["Laravel", "Astro", "React", "Cloudflare"],
    active: true,
  },
  {
    period: "Abril 2024 — Enero 2026",
    mode: "Presencial",
    role: "Técnico Informático",
    company: "MX Informática",
    location: "Encarnación, PY",
    desc: "Soporte técnico a usuarios y empresas. Diagnóstico y reparación de hardware, mantenimiento preventivo y correctivo, instalación y configuración de sistemas operativos y software.",
    tags: ["Hardware", "Soporte", "Windows"],
    active: false,
  },
];
---

<section id="experience" class="relative py-[80px]">
  <div class="w-full max-w-[1240px] mx-auto px-8 max-[720px]:px-5">

    <div class="flex justify-between items-end mb-10 gap-6">
      <div>
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted">02 / EXPERIENCIA</div>
        <h2 class="text-[clamp(40px,5.5vw,72px)] font-semibold tracking-[-0.03em] text-ink leading-none mt-2">
          Mi <span class="font-serif italic">experiencia</span>.
        </h2>
      </div>
      <p class="text-[15px] text-muted max-w-[40ch] leading-[1.5]">De los primeros proyectos al trabajo freelance actual.</p>
    </div>

    <div class="border-t border-[var(--line)]" role="list">
      {experience.map((e) => (
        <div
          class="grid grid-cols-[200px_1fr_1.2fr_auto] gap-8 py-7 border-b border-[var(--line)] items-start [transition:background_.3s_ease] hover:bg-[color-mix(in_oklab,var(--color-bg2)_50%,transparent)] max-[960px]:grid-cols-[1fr_1.2fr] max-[960px]:gap-[18px_24px] max-[640px]:grid-cols-1"
          role="listitem"
        >
          <!-- Period / mode -->
          <div class="font-mono text-[11px] tracking-[0.04em] text-muted leading-[1.6] max-[960px]:col-span-full max-[960px]:order-first">
            {e.active && (
              <span class="inline-block w-[6px] h-[6px] rounded-full bg-accent shadow-[0_0_0_3px_color-mix(in_oklab,var(--color-accent)_20%,transparent)] animate-pulse-dot mr-2 align-middle"></span>
            )}
            {e.period}
            <span class="block text-[color-mix(in_oklab,var(--color-muted)_70%,transparent)] mt-[2px]">{e.mode}</span>
          </div>

          <!-- Role -->
          <div>
            <h3 class="m-0 mb-[6px] text-[20px] tracking-[-0.015em] font-semibold text-ink">{e.role}</h3>
            <span class="text-accent text-[14px] font-medium block mb-[2px]">{e.company}</span>
            <span class="text-muted text-[13px]">{e.location}</span>
          </div>

          <!-- Description -->
          <p class="text-muted text-[14.5px] leading-[1.55] max-w-[48ch]">{e.desc}</p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-[6px] justify-end max-[960px]:col-span-full max-[960px]:justify-start" aria-label="Tecnologías">
            {e.tags.map((t) => (
              <span class="font-mono text-[10.5px] px-[10px] py-[5px] rounded-full border border-[var(--line)] text-muted whitespace-nowrap">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
