---
import BackgroundBeams from "./BackgroundBeams.astro";
import HeroCard from "./HeroCard.tsx";

interface Props {
  t: {
    prefix: string;
    queWord: string;
    italicWord: string;
    sub: string;
    stack: string;
    cta1: string;
    cta2: string;
  };
}

const { t } = Astro.props;
---

<header id="vanta-hero" class="pt-[140px] pb-[80px] relative max-[960px]:pt-[120px] max-[640px]:pt-[90px] max-[640px]:pb-0 [contain:paint]">
  <BackgroundBeams />
  <div class="w-full max-w-[1240px] mx-auto px-8 max-[720px]:px-5">
    <div class="relative z-10 grid grid-cols-[1.05fr_.95fr] gap-[60px] items-center max-[960px]:grid-cols-1 max-[960px]:gap-[40px]">

      <!-- Left -->
      <div>
        <h1
          id="hero-title"
          data-greeting={t.greeting}
          data-italic={t.italicName}
          class="text-[clamp(44px,6.4vw,88px)] leading-[.98] tracking-[-0.035em] font-semibold mb-6 text-ink text-balance max-[640px]:text-[44px] max-[640px]:leading-[0.97]"
        >
          <span id="hero-g"></span><br />
          <span id="hero-italic-wrap" class="relative font-serif italic text-[1.05em] tracking-[-0.02em] text-ink inline-block translate-y-[0.06em] whitespace-nowrap opacity-0 after:content-[''] after:absolute after:[left:-0.06em] after:[right:-0.06em] after:[bottom:-0.0em] after:[height:0.18em] after:bg-accent after:opacity-0 after:-z-10 after:rounded-sm after:transition-opacity after:duration-500"><span id="hero-i"></span></span><span id="hero-dot" class="opacity-0 transition-opacity duration-300">.</span>
        </h1>

        <p class="text-[18px] text-muted max-w-[520px] mb-8 leading-[1.6] max-[640px]:text-[15px] max-[640px]:mb-6">
          {t.sub}<br />
        </p>

        <div class="flex gap-3 flex-wrap items-center">
          <a
            class="group inline-flex items-center gap-[10px] px-[22px] py-[14px] rounded-full text-[14.5px] font-medium tracking-[-0.005em] bg-ink text-bg [transition:translate_200ms_ease,background_200ms_ease] hover:bg-[#e0e0e0] hover:-translate-y-px"
            href="#work"
          >
            {t.cta1} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-shrink-0 [transition:translate_200ms_ease] group-hover:translate-x-[3px]"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            class="group inline-flex items-center gap-[10px] pl-2 pr-[22px] py-[14px] rounded-full text-[14.5px] font-medium tracking-[-0.005em] bg-transparent text-ink transition-colors duration-200 hover:text-accent"
            href="#contact"
          >
            {t.cta2} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-shrink-0 [transition:translate_200ms_ease] group-hover:translate-x-[3px]"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: visual -->
      <div class="max-[640px]:mt-7">
        <HeroCard client:load />
      </div>

    </div>
  </div>
</header>

<script>
  const h1 = document.getElementById("hero-title") as HTMLElement;
  const gEl = document.getElementById("hero-g") as HTMLElement;
  const iWrap = document.getElementById("hero-italic-wrap") as HTMLElement;
  const iEl = document.getElementById("hero-i") as HTMLElement;
  const dotEl = document.getElementById("hero-dot") as HTMLElement;

  const greeting = h1.dataset.greeting ?? "";
  const italic = h1.dataset.italic ?? "";

  const cursor = document.createElement("span");
  cursor.textContent = "|";
  cursor.className = "animate-blink text-accent ml-[0.05em]";

  function type(target: HTMLElement, text: string, delay: number): Promise<void> {
    return new Promise((resolve) => {
      let i = 0;
      target.appendChild(cursor);
      const tick = () => {
        if (i < text.length) {
          target.insertBefore(document.createTextNode(text[i]), cursor);
          i++;
          setTimeout(tick, delay);
        } else {
          resolve();
        }
      };
      setTimeout(tick, delay);
    });
  }

  async function run() {
    await type(gEl, greeting, 55);
    // pausa entre líneas
    await new Promise(r => setTimeout(r, 180));
    iWrap.classList.remove("opacity-0");
    await type(iEl, italic, 55);
    // mostrar subrayado y punto
    iWrap.classList.add("after:opacity-85");
    dotEl.classList.remove("opacity-0");
    // cursor parpadea 3s luego desaparece
    await new Promise(r => setTimeout(r, 3000));
    cursor.style.transition = "opacity 0.4s";
    cursor.style.opacity = "0";
    setTimeout(() => cursor.remove(), 400);
  }

  run();
</script>

