---
interface Props {
  t: { projects: string; experience: string; about: string; contact: string; cv: string; cvUrl: string };
  lang: "es" | "en";
}

const { t, lang } = Astro.props;

const links = [
  {
    label: t.projects,
    href: "#work",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"/></svg>`,
  },
  {
    label: t.experience,
    href: "#experience",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>`,
  },
  {
    label: t.about,
    href: "#about",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>`,
  },
  {
    label: t.contact,
    href: "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>`,
  },
];

const cvIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>`;
---

<div class="fixed top-[18px] inset-x-0 z-50 flex justify-center pointer-events-none">
  <nav
    id="nav"
    aria-label="Principal"
    class="group pointer-events-auto flex items-center gap-1 bg-[rgba(20,23,30,.82)] [backdrop-filter:blur(18px)_saturate(140%)] [-webkit-backdrop-filter:blur(18px)_saturate(140%)] border border-[rgba(255,255,255,.10)] rounded-full pl-[14px] pr-[6px] py-[6px] [transition:box-shadow_.35s_ease,background_.35s_ease] shadow-nav data-[collapsed]:shadow-nav-active data-[collapsed]:bg-[rgba(20,23,30,.96)]"
  >
    <a
      class="flex items-center gap-[10px] py-1 pr-3 pl-1 border-r border-[rgba(255,255,255,.10)] mr-1 flex-shrink-0 max-[880px]:border-r-0 max-[880px]:mr-0"
      href="/"
      aria-label="Ir al inicio"
    >
      <img src="https://pub-35ad8d60b43c4e38adcab3857e0a55b8.r2.dev/avatar.webp" alt="" width="30" height="30" draggable="false" class="w-[30px] h-[30px] rounded-lg object-cover flex-shrink-0" />
      <span class="font-semibold text-[14px] tracking-[-0.01em] whitespace-nowrap overflow-hidden max-w-[120px] opacity-100 [transition:max-width_.6s_ease,opacity_.45s_ease,margin_.6s_ease] group-data-[collapsed]:max-w-0 group-data-[collapsed]:opacity-0 group-data-[collapsed]:ml-[-10px]">Matias Sanabria</span>
    </a>

    {links.map((l) => (
      <a
        class="max-[880px]:hidden inline-flex items-center gap-[7px] px-3 py-2 rounded-full text-[13.5px] text-ink opacity-[0.78] [transition:opacity_.2s_ease,background_.2s_ease,padding_.6s_ease] whitespace-nowrap flex-shrink-0 hover:opacity-100 hover:bg-[rgba(255,255,255,.07)] group-data-[collapsed]:px-[9px]"
        href={l.href}
        title={l.label}
      >
        <span class="flex items-center flex-shrink-0" set:html={l.icon} />
        <span class="whitespace-nowrap overflow-hidden max-w-[100px] [transition:max-width_.6s_ease,opacity_.45s_ease,margin_.6s_ease] group-data-[collapsed]:max-w-0 group-data-[collapsed]:opacity-0 group-data-[collapsed]:ml-[-7px]">{l.label}</span>
      </a>
    ))}
    <!-- Hamburger (mobile only) -->
    <button
      id="nav-burger"
      aria-label="Abrir menú"
      class="hidden max-[640px]:flex items-center justify-center w-9 h-9 rounded-full border border-[rgba(255,255,255,.10)] bg-[rgba(255,255,255,.06)] cursor-pointer flex-shrink-0 ml-1"
    >
      <svg width="15" height="12" viewBox="0 0 15 12" fill="none" aria-hidden="true">
        <rect width="15" height="1.5" rx="1" fill="currentColor"/>
        <rect y="5.25" width="15" height="1.5" rx="1" fill="currentColor"/>
        <rect y="10.5" width="15" height="1.5" rx="1" fill="currentColor"/>
      </svg>
    </button>

    <!-- Language switcher -->
    <div class="relative ml-1 flex-shrink-0" id="lang-switcher">
      <button
        id="lang-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        class="flex items-center gap-[5px] px-[9px] py-[7px] rounded-full font-mono text-[11px] tracking-[0.06em] text-ink hover:bg-[rgba(255,255,255,.07)] transition-colors duration-200 cursor-pointer"
      >
        <img
          src={lang === "es" ? "https://flagcdn.com/w40/py.png" : "https://flagcdn.com/w40/us.png"}
          alt={lang === "es" ? "PY" : "US"}
          width="20" height="14"
          class="rounded-[3px] object-cover flex-shrink-0"
        />
        <span>{lang.toUpperCase()}</span>
        <svg id="lang-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="[transition:rotate_200ms_ease]"><path d="M6 9l6 6 6-6"/></svg>
      </button>

      <div
        id="lang-menu"
        class="hidden absolute right-0 top-[calc(100%+10px)] bg-[rgba(18,21,28,.97)] [backdrop-filter:blur(20px)] border border-[rgba(255,255,255,.10)] rounded-[14px] py-[5px] shadow-[0_8px_32px_rgba(0,0,0,.5)] min-w-[190px] z-50"
      >
        <a href="/" class="flex items-center gap-3 px-3 py-[9px] hover:bg-[rgba(255,255,255,.06)] transition-colors duration-150 rounded-[9px] mx-[5px]">
          <img src="https://flagcdn.com/w40/py.png" alt="PY" width="22" height="15" class="rounded-[3px] object-cover flex-shrink-0" />
          <span class="flex flex-col flex-1 min-w-0">
            <span class="font-mono text-[11px] text-ink font-semibold leading-none mb-[3px]">ES</span>
            <span class="text-[10px] text-muted leading-none">Español (Paraguay)</span>
          </span>
          {lang === "es" && (
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
          )}
        </a>
        <a href="/en" class="flex items-center gap-3 px-3 py-[9px] hover:bg-[rgba(255,255,255,.06)] transition-colors duration-150 rounded-[9px] mx-[5px]">
          <img src="https://flagcdn.com/w40/us.png" alt="US" width="22" height="15" class="rounded-[3px] object-cover flex-shrink-0" />
          <span class="flex flex-col flex-1 min-w-0">
            <span class="font-mono text-[11px] text-ink font-semibold leading-none mb-[3px]">EN</span>
            <span class="text-[10px] text-muted leading-none">English (US)</span>
          </span>
          {lang === "en" && (
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
          )}
        </a>
      </div>
    </div>
    <a
      class="ml-1 max-[640px]:hidden inline-flex items-center gap-2 bg-accent text-[#0A1A1F] px-4 py-[9px] rounded-full text-[13.5px] font-semibold [transition:translate_.2s_ease,background_.2s_ease,padding_.6s_ease] whitespace-nowrap flex-shrink-0 hover:bg-[color-mix(in_oklab,var(--color-accent)_85%,#fff)] hover:-translate-y-px group-data-[collapsed]:px-[11px]"
      href={t.cvUrl}
      download
      title={t.cv}
    >
      <span class="flex items-center flex-shrink-0" set:html={cvIcon} />
      <span class="whitespace-nowrap overflow-hidden max-w-[120px] [transition:max-width_.6s_ease,opacity_.45s_ease,margin_.6s_ease] group-data-[collapsed]:max-w-0 group-data-[collapsed]:opacity-0 group-data-[collapsed]:ml-[-8px]">{t.cv}</span>
    </a>
  </nav>
</div>

<!-- Mobile drawer -->
<div
  id="nav-drawer"
  class="fixed inset-0 z-[200] flex flex-col bg-[#13161C] translate-x-full opacity-0 pointer-events-none [transition:transform_.38s_cubic-bezier(0.16,1,0.3,1),opacity_.3s_ease]"
>
  <!-- Top row -->
  <div class="flex items-center justify-between p-5 pb-0">
    <a href="/" class="flex items-center gap-[9px] no-underline text-ink" id="drawer-home">
      <img src="https://pub-35ad8d60b43c4e38adcab3857e0a55b8.r2.dev/avatar.webp" alt="" width="28" height="28" draggable="false" class="w-7 h-7 rounded-lg object-cover flex-shrink-0" />
      <span class="font-semibold text-[17px] tracking-[-0.01em]">Mati Sanabria</span>
    </a>
    <button
      id="nav-drawer-close"
      aria-label="Cerrar menú"
      class="w-9 h-9 rounded-full border border-[rgba(255,255,255,.10)] bg-[rgba(255,255,255,.06)] grid place-items-center cursor-pointer text-ink text-[17px] flex-shrink-0"
    >✕</button>
  </div>

  <!-- Nav links -->
  <nav class="flex-1 px-5 mt-9">
    {links.map((l, i) => (
      <a
        href={l.href}
        class="drawer-link flex items-center justify-between py-[17px] border-b border-[rgba(255,255,255,.10)] no-underline"
      >
        <span class="text-[22px] font-semibold tracking-[-0.025em] text-ink">{l.label}</span>
        <span class="font-mono text-[11px] text-muted">0{i + 1}</span>
      </a>
    ))}
  </nav>

  <!-- Bottom -->
  <div class="px-5 pb-8 mt-6">
    <a
      href={t.cvUrl}
      download
      class="drawer-link flex items-center justify-center gap-2 bg-accent text-[#0A1A1F] rounded-[14px] py-[15px] text-[15px] font-bold no-underline mb-[14px]"
    >
      <span set:html={cvIcon} />
      {t.cv}
    </a>
    <div class="flex justify-center gap-[18px] font-mono text-[10.5px] text-muted tracking-[.08em]">
      <a href="https://github.com/matisanabria" target="_blank" rel="noopener noreferrer" class="no-underline text-muted hover:text-ink transition-colors">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/matisanabriaf/" target="_blank" rel="noopener noreferrer" class="no-underline text-muted hover:text-ink transition-colors">LinkedIn ↗</a>
    </div>
  </div>
</div>

<script>
  const nav = document.getElementById("nav")!;
  let collapseTimer: ReturnType<typeof setTimeout> | null = null;
  let isScrolled = false;
  let rafPending = false;

  function setCollapsed(on: boolean) {
    if (on) nav.dataset.collapsed = "";
    else delete nav.dataset.collapsed;
  }

  function applyScroll() {
    rafPending = false;
    isScrolled = window.scrollY > 500;
    if (!isScrolled) {
      if (collapseTimer) { clearTimeout(collapseTimer); collapseTimer = null; }
      setCollapsed(false);
    } else {
      if (!nav.matches(":hover")) setCollapsed(true);
    }
  }

  function onScroll() {
    if (!rafPending) {
      rafPending = true;
      requestAnimationFrame(applyScroll);
    }
  }

  nav.addEventListener("mouseenter", () => {
    if (collapseTimer) { clearTimeout(collapseTimer); collapseTimer = null; }
    if (isScrolled) setCollapsed(false);
  });

  nav.addEventListener("mouseleave", () => {
    if (isScrolled) {
      collapseTimer = setTimeout(() => setCollapsed(true), 1000);
    }
  });

  window.addEventListener("scroll", onScroll, { passive: true });
  applyScroll();

  const trigger = document.getElementById("lang-trigger")!;
  const menu = document.getElementById("lang-menu")!;
  const chevron = document.getElementById("lang-chevron")!;

  function openMenu() {
    menu.classList.remove("hidden");
    trigger.setAttribute("aria-expanded", "true");
    chevron.style.rotate = "180deg";
  }
  function closeMenu() {
    menu.classList.add("hidden");
    trigger.setAttribute("aria-expanded", "false");
    chevron.style.rotate = "0deg";
  }

  trigger.addEventListener("click", (e) => {
    e.stopPropagation();
    menu.classList.contains("hidden") ? openMenu() : closeMenu();
  });
  document.addEventListener("click", closeMenu);
  menu.addEventListener("click", (e) => e.stopPropagation());

  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener("click", (e) => {
      const id = (a as HTMLAnchorElement).getAttribute("href")!.slice(1);
      const el = document.getElementById(id);
      if (el) {
        e.preventDefault();
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: "smooth" });
      }
    });
  });

  // Mobile drawer
  const burger = document.getElementById("nav-burger");
  const drawer = document.getElementById("nav-drawer")!;
  const drawerClose = document.getElementById("nav-drawer-close");

  function openDrawer() {
    drawer.classList.remove("translate-x-full", "opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
  }
  function closeDrawer() {
    drawer.classList.add("translate-x-full", "opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
  }

  burger?.addEventListener("click", openDrawer);
  drawerClose?.addEventListener("click", closeDrawer);
  drawer.querySelectorAll(".drawer-link").forEach((a) => a.addEventListener("click", closeDrawer));

</script>
