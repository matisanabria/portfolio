---
import tailwindcss from "@tailwindcss/vite";
import type { Project } from "../i18n/types";
import {
  siLaravel,
  siAstro,
  siReact,
  siMariadb,
  siSqlite,
  siHibernate,
  siCodeigniter,
  siMysql,
  siOpenjdk,
  siFlyway,
  siApachemaven,
  siPhp,
  siCloudflare,
  siTailwindcss,
} from "simple-icons";

interface Props {
  items: Project[];
  t: {
    sectionLabel: string;
    heading: string;
    headingItalic: string;
    sub: string;
    repo: string;
    private: string;
    live: string;
  };
}

const { items: projects, t } = Astro.props;

const TECH_ICONS: Record<string, { path: string; hex: string; name: string }> = {
  laravel:     { path: siLaravel.path,    hex: siLaravel.hex,    name: "Laravel"     },
  astro:       { path: siAstro.path,      hex: siAstro.hex,      name: "Astro"       },
  react:       { path: siReact.path,      hex: siReact.hex,      name: "React"       },
  mariadb:     { path: siMariadb.path,    hex: siMariadb.hex,    name: "MariaDB"     },
  sqlite:      { path: siSqlite.path,     hex: siSqlite.hex,     name: "SQLite"      },
  hibernate:   { path: siHibernate.path,  hex: siHibernate.hex,  name: "Hibernate"   },
  codeigniter: { path: siCodeigniter.path,hex: siCodeigniter.hex,name: "CodeIgniter" },
  mysql:       { path: siMysql.path,      hex: siMysql.hex,      name: "MySQL"       },
  java:        { path: siOpenjdk.path,    hex: siOpenjdk.hex,    name: "Java"        },
  flyway:      { path: siFlyway.path,     hex: siFlyway.hex,     name: "Flyway"      },
  maven:       { path: siApachemaven.path, hex: siApachemaven.hex, name: "Maven"      },
  php:         { path: siPhp.path,         hex: siPhp.hex,         name: "PHP"        },
  cloudflare: { path: siCloudflare.path,  hex: siCloudflare.hex,  name: "Cloudflare"  },
  tailwindcss: { path: siTailwindcss.path,  hex: siTailwindcss.hex,  name: "Tailwind CSS" },
};
---

<section id="work" class="relative py-[96px] border-t border-[var(--line)]">
  <div class="w-full max-w-[1240px] mx-auto px-8 max-[720px]:px-5">

    <!-- Section header -->
    <div class="grid grid-cols-[1fr_auto] gap-7 items-end mb-14 max-[760px]:grid-cols-1">
      <div>
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted mb-[14px]">{t.sectionLabel}</div>
        <h2 class="text-[clamp(38px,4.6vw,64px)] font-semibold tracking-[-0.03em] text-ink leading-none m-0 max-[640px]:text-[44px]">
          {t.heading} <span class="font-serif italic text-accent">{t.headingItalic}</span>.
        </h2>
      </div>
    </div>

    <!-- Project list -->
    <ol class="list-none m-0 p-0 border-t border-[var(--line)]">
      {projects.map((p, i) => {
        const techList = p.tech ?? [];
        const index = String(i + 1).padStart(2, "0");
        return (
          <li
            data-project-row
            class="group border-b border-[var(--line)] cursor-pointer hover:bg-[var(--color-bg2)] [&[data-open]]:bg-[var(--color-bg2)] transition-colors duration-200"
          >
            <!-- Collapsed header -->
            <div
              data-project-toggle
              class="flex items-center gap-5 py-7 px-2 max-[480px]:gap-3 max-[480px]:py-5"
            >
              <!-- Index -->
              <span class="font-mono text-[11px] text-muted w-6 flex-shrink-0 select-none leading-none">
                {index}
              </span>

              <!-- Name -->
              <h3 class="flex-1 min-w-0 m-0 text-[clamp(22px,2.8vw,40px)] font-bold tracking-[-0.03em] text-ink leading-none [transition:translate_400ms_ease-in-out] group-hover:translate-x-[5px]">
                {p.name}
              </h3>

              <!-- Type + chevron -->
              <div class="flex items-center gap-5 flex-shrink-0 max-[480px]:gap-3">
                <span class="font-mono text-[11px] text-muted max-[600px]:hidden">{p.type}</span>
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-muted/50 flex-shrink-0 [transition:rotate_300ms_ease-out] [li[data-open]_&]:rotate-180"
                >
                  <path d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>

            <!-- Expandable panel -->
            <div class="grid grid-rows-[0fr] [li[data-open]_&]:grid-rows-[1fr] transition-[grid-template-rows] duration-400 [transition-timing-function:cubic-bezier(.22,1,.36,1)]">
              <div class="overflow-hidden">
                <div class="flex gap-14 pl-11 pr-2 pb-9 pt-1 max-[640px]:flex-col max-[640px]:gap-6 max-[480px]:pl-0">

                  <!-- Left: tech icons -->
                  {techList.length > 0 && (
                    <div class="grid grid-cols-[repeat(auto-fill,minmax(48px,1fr))] gap-x-3 gap-y-4 w-[140px] flex-shrink-0 max-[640px]:w-auto max-[640px]:flex max-[640px]:flex-wrap">
                      {techList.map((tech) => {
                        const icon = TECH_ICONS[tech];
                        return icon ? (
                          <div class="relative group/icon flex flex-col items-center gap-[5px]">
                            <svg
                              width="22"
                              height="22"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              style={`fill: #${icon.hex}; opacity: 0.6;`}
                              class="[transition:opacity_.2s_ease] group-hover/icon:!opacity-95"
                            >
                              <path d={icon.path} />
                            </svg>
                            <span class="font-mono text-[8px] tracking-[0.08em] text-muted/50 group-hover/icon:text-muted transition-colors duration-150 whitespace-nowrap">
                              {icon.name}
                            </span>
                          </div>
                        ) : (
                          <span class="font-mono text-[9px] text-muted/50">{tech}</span>
                        );
                      })}
                    </div>
                  )}

                  <!-- Right: desc + links -->
                  <div class="flex flex-col gap-5 flex-1 min-w-0">
                    {p.desc && (
                      <p class="m-0 text-[14px] text-muted leading-[1.65] max-w-[52ch]">
                        {p.desc}
                      </p>
                    )}

                    <!-- Links -->
                    <div class="flex items-center gap-5">
                      {p.repo && (
                        <a href={p.repo} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-[6px] text-muted hover:text-ink transition-colors duration-200">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-shrink-0">
                            <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.8 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2.9-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.5-1.5 7.8-5.8 7.8-10.9C23.5 5.7 18.3.5 12 .5z"/>
                          </svg>
                          <span class="text-[10px] uppercase tracking-[0.12em]">{t.repo}</span>
                        </a>
                      )}
                      {!p.repo && (
                        <span class="flex items-center gap-[6px] text-muted opacity-20 cursor-default">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-shrink-0">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                          </svg>
                          <span class="text-[10px] uppercase tracking-[0.12em]">{t.private}</span>
                        </span>
                      )}
                      {p.live && (
                        <a href={p.live} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-[6px] text-accent hover:text-accent/80 transition-colors duration-200">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-shrink-0">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                          </svg>
                          <span class="text-[10px] uppercase tracking-[0.12em]">{t.live}</span>
                        </a>
                      )}
                    </div>
                  </div>

                </div>
              </div>
            </div>

          </li>
        );
      })}
    </ol>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-row]').forEach(row => {
    row.querySelector('[data-project-toggle]')?.addEventListener('click', () => {
      const isOpen = row.hasAttribute('data-open');
      document.querySelectorAll('[data-project-row][data-open]').forEach(r => r.removeAttribute('data-open'));
      if (!isOpen) row.setAttribute('data-open', '');
    });
    row.querySelectorAll('a').forEach(a => a.addEventListener('click', e => e.stopPropagation()));
  });
</script>
